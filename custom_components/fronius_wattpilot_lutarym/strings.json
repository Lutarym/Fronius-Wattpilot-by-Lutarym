{
  "config": {
    "step": {
      "user": {
        "title": "Fronius Wattpilot by Lutarym",
        "description": "Direct local connection to the Wattpilot. No Fronius account required.",
        "data": {
          "host": "IP address",
          "password": "Wattpilot password"
        },
        "data_description": {
          "host": "The local IP address of the Wattpilot on your home network.",
          "password": "The password set in the Wattpilot app."
        }
      },
      "reauth_confirm": {
        "title": "Re-enter password",
        "description": "The stored password is no longer accepted by the Wattpilot.",
        "data": {
          "password": "Wattpilot password"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the Wattpilot. Please check IP address and password.",
      "unknown": "Unknown error."
    },
    "abort": {
      "already_configured": "This Wattpilot is already configured.",
      "reauth_successful": "Re-authentication was successful."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "description": "Controls which entities are created.",
        "data": {
          "only_available": "Only create available entities"
        },
        "data_description": {
          "only_available": "On connect the integration checks which values the Wattpilot actually reports and creates entities only for those. Turn off to create every possible entity."
        }
      }
    }
